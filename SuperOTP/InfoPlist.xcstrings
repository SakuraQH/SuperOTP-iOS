{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperOTP uses the camera to scan the QR codes services show when you turn on two-factor authentication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperOTP 使用相机扫描开启两步验证时网站显示的二维码。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperOTP uses Face ID to keep your verification codes locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperOTP 使用面容 ID 锁定你的验证码。"
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperOTP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SuperOTP"
          }
        }
      }
    }
  },
  "version": "1.0"
