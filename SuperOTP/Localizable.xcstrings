    "That picture couldn't be used": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用这张图片"
          }
        }
      }
    },
    "The accounts in it are kept and move to “Other”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的账号不会被删除，会移到「其他」。"
          }
        }
      }
    },
    "The backup could not be read": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份格式无法读取"
          }
        }
      }
    },
    "The backup folder is no longer available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份目录已不可用"
          }
        }
      }
    },
    "The clipboard is empty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板里没有内容"
          }
        }
      }
    },
    "The counter must be a whole number of 0 or more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计数器需要是不小于 0 的整数。"
          }
        }
      }
    },
    "The launch backup did not finish": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动备份没有完成"
          }
        }
      }
    },
    "The link contains the secret key. Anyone who sees it can generate your codes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接里包含密钥，任何看到它的人都能生成你的验证码。"
          }
        }
      }
    },
    "The passwords don't match.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次输入的密码不一致"
          }
        }
      }
    },
    "The period must be a whole number of seconds greater than 0.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周期需要是大于 0 的整数秒。"
          }
        }
      }
    },
    "The setup key isn't valid Base32 (letters A–Z and digits 2–7).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥不是有效的 Base32（字母 A–Z 和数字 2–7）。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "There are no backups in %@. Check the folder, or import a backup file instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」中没有备份。请确认备份目录，或直接导入备份文件。"
          }
        }
      }
    },
    "This backup was made by a newer version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份版本不受支持，请更新应用"
          }
        }
      }
    },
    "This device has no passcode or biometrics set up, so App Lock can't be used.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备未设置锁屏密码或生物识别，无法使用应用锁。"
          }
        }
      }
    },
    "This is not a SuperOTP or CloudOTP backup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 SuperOTP 或 CloudOTP 备份文件"
          }
        }
      }
    },
    "This password only encrypts backup files and is separate from App Lock. If you forget it, your backups can't be restored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份密码只用于加密备份文件，与应用锁无关。忘记密码将无法恢复备份。"
          }
        }
      }
    },
    "This QR code contains the secret key. Don't take screenshots of it or share it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维码包含密钥，请勿截屏或发给他人。"
          }
        }
      }
    },
    "Touch ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控 ID"
          }
        }
      }
